<!--
  RoboWeaver Demo Scene — Tabletop Pick-and-Place
  
  A 6-DOF robot arm with a parallel gripper mounted at the origin.
  A red cube sits on a narrow stand within reach.
  The arm must reach forward, grasp the cube, and lift it.
-->
<mujoco model="roboweaver_demo">
  <compiler angle="radian"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast">
    <flag contact="enable"/>
  </option>

  <default>
    <joint armature="0.01" damping="0.8"/>
    <geom condim="4" friction="1 0.5 0.01" solimp="0.95 0.99 0.001 0.5 2" solref="0.02 1"/>
    <position forcerange="-100 100"/>
  </default>

  <visual>
    <global offwidth="1280" offheight="960"/>
    <rgba haze="0.15 0.2 0.3 1"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.85 0.85 0.88" rgb2="0.75 0.75 0.78"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.15"/>
    <material name="dark_metal" rgba="0.18 0.18 0.22 1" specular="0.6" shininess="0.8"/>
    <material name="light_metal" rgba="0.35 0.35 0.40 1" specular="0.5" shininess="0.6"/>
    <material name="mid_metal" rgba="0.28 0.28 0.32 1" specular="0.5" shininess="0.7"/>
    <material name="finger_mat" rgba="0.22 0.22 0.26 1" specular="0.4" shininess="0.5"/>
    <material name="stand_mat" rgba="0.55 0.55 0.60 1" specular="0.3"/>
    <material name="red_mat" rgba="0.88 0.12 0.12 1" specular="0.4" shininess="0.6"/>
  </asset>

  <worldbody>
    <!-- Lighting -->
    <light pos="0.3 -0.3 1.5" dir="0 0.1 -1" diffuse="0.9 0.9 0.95" specular="0.4 0.4 0.4"
           castshadow="true"/>
    <light pos="-0.3 0.5 1.0" dir="0.2 -0.3 -1" diffuse="0.3 0.3 0.4" specular="0.1 0.1 0.1"/>

    <!-- Ground plane -->
    <geom name="ground" type="plane" size="1.5 1.5 0.01" material="grid"/>

    <!-- ════════════════════════════════════════════ -->
    <!--              ROBOT ARM (6-DOF)               -->
    <!-- ════════════════════════════════════════════ -->

    <body name="base" pos="0 0 0">
      <geom name="base_mount" type="cylinder" size="0.06 0.015" material="dark_metal" mass="5"/>

      <!-- Link 1: Base rotation (yaw) -->
      <body name="link1" pos="0 0 0.015">
        <joint name="j0" type="hinge" axis="0 0 1" range="-3.14 3.14" damping="1.2"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0 0 0.12" size="0.042"
              material="dark_metal" mass="2.0"/>

        <!-- Link 2: Shoulder pitch -->
        <body name="link2" pos="0 0 0.12">
          <joint name="j1" type="hinge" axis="0 1 0" range="-2.35 2.35" damping="1.2"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0 0 0.22" size="0.037"
                material="mid_metal" mass="1.8"/>

          <!-- Link 3: Elbow pitch -->
          <body name="link3" pos="0 0 0.22">
            <joint name="j2" type="hinge" axis="0 1 0" range="-2.61 2.61" damping="1.0"/>
            <geom name="link3_geom" type="capsule" fromto="0 0 0 0 0 0.20" size="0.032"
                  material="light_metal" mass="1.4"/>

            <!-- Link 4: Wrist pitch -->
            <body name="link4" pos="0 0 0.20">
              <joint name="j3" type="hinge" axis="0 1 0" range="-2.61 2.61" damping="0.6"/>
              <geom name="link4_geom" type="capsule" fromto="0 0 0 0 0 0.06" size="0.026"
                    material="light_metal" mass="0.8"/>

              <!-- Link 5: Wrist yaw -->
              <body name="link5" pos="0 0 0.06">
                <joint name="j4" type="hinge" axis="0 0 1" range="-3.14 3.14" damping="0.4"/>
                <geom name="link5_geom" type="cylinder" size="0.026 0.012"
                      material="mid_metal" mass="0.5"/>

                <!-- Link 6: Wrist roll -->
                <body name="link6" pos="0 0 0.012">
                  <joint name="j5" type="hinge" axis="0 1 0" range="-3.14 3.14" damping="0.4"/>
                  <geom name="link6_geom" type="cylinder" size="0.023 0.008"
                        material="light_metal" mass="0.3"/>

                  <!-- ═══ Gripper (parallel jaw) ═══ -->
                  <body name="gripper_base" pos="0 0 0.008">
                    <geom name="gripper_mount" type="box" size="0.018 0.034 0.006"
                          material="finger_mat" mass="0.15"/>

                    <!-- End-effector site: center of finger contact zone -->
                    <site name="ee_site" pos="0 0 0.046" size="0.004" rgba="0 0.9 0.3 0.6"/>

                    <!-- Left finger -->
                    <body name="finger_left" pos="0 0.035 0.006">
                      <joint name="jf_left" type="slide" axis="0 -1 0" range="0 0.035"
                             damping="8" armature="0.005"/>
                      <geom name="lf_geom" type="box" size="0.011 0.005 0.035"
                            pos="0 0 0.035" material="finger_mat" mass="0.04"
                            friction="2.0 0.5 0.01" condim="6" solimp="0.95 0.99 0.001 0.5 2"/>
                    </body>

                    <!-- Right finger -->
                    <body name="finger_right" pos="0 -0.035 0.006">
                      <joint name="jf_right" type="slide" axis="0 1 0" range="0 0.035"
                             damping="8" armature="0.005"/>
                      <geom name="rf_geom" type="box" size="0.011 0.005 0.035"
                            pos="0 0 0.035" material="finger_mat" mass="0.04"
                            friction="2.0 0.5 0.01" condim="6" solimp="0.95 0.99 0.001 0.5 2"/>
                    </body>
                  </body>

                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ════════════════════════════════════════════ -->
    <!--                OBJECT STAND                  -->
    <!-- ════════════════════════════════════════════ -->

    <body name="stand" pos="0.30 0 0">
      <geom name="stand_pillar" type="cylinder" fromto="0 0 0 0 0 0.10"
            size="0.015" material="stand_mat"/>
      <geom name="stand_top" type="cylinder" size="0.022 0.005" pos="0 0 0.105"
            material="stand_mat"/>
    </body>

    <!-- ════════════════════════════════════════════ -->
    <!--                 RED CUBE                     -->
    <!-- ════════════════════════════════════════════ -->

    <body name="red_cube" pos="0.30 0 0.13">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02"
            material="red_mat" mass="0.05"
            friction="1.5 0.5 0.01" condim="6"
            solimp="0.95 0.99 0.001 0.5 2" solref="0.02 1"/>
      <site name="cube_center" size="0.003" rgba="1 1 0 0.3"/>
    </body>

  </worldbody>

  <!-- ════════════════════════════════════════════ -->
  <!--           EQUALITY CONSTRAINTS               -->
  <!-- ════════════════════════════════════════════ -->

  <equality>
    <!-- Couple left and right fingers: q_right = q_left -->
    <joint joint1="jf_left" joint2="jf_right" polycoef="0 1 0 0 0"/>
  </equality>

  <!-- ════════════════════════════════════════════ -->
  <!--           CONTACT EXCLUSIONS                 -->
  <!-- ════════════════════════════════════════════ -->

  <contact>
    <exclude body1="link3" body2="link5"/>
    <exclude body1="link3" body2="link6"/>
    <exclude body1="link3" body2="gripper_base"/>
    <exclude body1="link4" body2="gripper_base"/>
    <exclude body1="link4" body2="finger_left"/>
    <exclude body1="link4" body2="finger_right"/>
    <exclude body1="link5" body2="finger_left"/>
    <exclude body1="link5" body2="finger_right"/>
    <exclude body1="link6" body2="finger_left"/>
    <exclude body1="link6" body2="finger_right"/>
  </contact>

  <!-- ════════════════════════════════════════════ -->
  <!--          ACTUATORS (position control)        -->
  <!-- ════════════════════════════════════════════ -->

  <actuator>
    <position name="a0" joint="j0" kp="100" ctrlrange="-3.14 3.14"/>
    <position name="a1" joint="j1" kp="100" ctrlrange="-2.35 2.35"/>
    <position name="a2" joint="j2" kp="80"  ctrlrange="-2.61 2.61"/>
    <position name="a3" joint="j3" kp="50"  ctrlrange="-2.61 2.61"/>
    <position name="a4" joint="j4" kp="40"  ctrlrange="-3.14 3.14"/>
    <position name="a5" joint="j5" kp="40"  ctrlrange="-3.14 3.14"/>
    <position name="grip" joint="jf_left" kp="300" ctrlrange="0 0.035"/>
  </actuator>

</mujoco>
