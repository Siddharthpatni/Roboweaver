# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROBOWEAVER_API_TOKEN=replace-with-a-random-token

# Comma-separated exact browser origins allowed to call the API.
ROBOWEAVER_ALLOWED_ORIGINS=http://localhost:3000

# API resource bounds. Keep these defaults unless load testing justifies a change.
ROBOWEAVER_MAX_CONCURRENT_REQUESTS=32
ROBOWEAVER_RATE_LIMIT_PER_MINUTE=240
ROBOWEAVER_EXPENSIVE_RATE_LIMIT_PER_MINUTE=30

# Same-network workbench. Set the bind and LAN mode together. The backend remains
# loopback/private and its token stays in the frontend server process.
ROBOWEAVER_FRONTEND_BIND=127.0.0.1
ROBOWEAVER_LAN_MODE=0
# Compiler/read-only routes are available in LAN mode. Hardware/network/AI mutation
# remains denied unless this separate flag is deliberately enabled.
ROBOWEAVER_LAN_ALLOW_CONTROL=0
# Optional exact hostnames for DNS-based LAN access (IP access needs no entry).
ROBOWEAVER_LAN_ALLOWED_HOSTS=

# Native LLVM/MLIR evidence: off, auto, or required. In auto mode compilation
# invokes mlir-opt when installed and reports unavailable otherwise.
ROBOWEAVER_MLIR_MODE=auto
# ROBOWEAVER_MLIR_OPT=mlir-opt-18

# Fully local AI / Ollama. Every feature is opt-in and falls back honestly.
OLLAMA_HOST=http://localhost:11434
# Compose reaches an Ollama process on the container host through this origin.
ROBOWEAVER_CONTAINER_OLLAMA_HOST=http://host.docker.internal:11434
ROBOWEAVER_MODEL_DEFAULT=llama3.1:8b
# Optional per-feature overrides:
# ROBOWEAVER_MODEL_PARSER=llama3.2:3b
# ROBOWEAVER_MODEL_EXPLAINER=llama3.1:8b
# ROBOWEAVER_MODEL_RECOVERY=llama3.1:8b
# ROBOWEAVER_MODEL_COMPOSER=llama3.1:8b
# ROBOWEAVER_MODEL_ENRICHMENT=llama3.1:8b
# ROBOWEAVER_MODEL_CODEGEN=codellama:7b
# ROBOWEAVER_MODEL_ADVISOR=llama3.2:3b
# ROBOWEAVER_MODEL_CHAT=llama3.1:8b

# Optional remote AI. Keep the key only in the ignored local .env file.
# The free router chooses among currently available free models, so the actual
# responding model can change. Selecting OpenRouter in the UI is explicit.
OPENROUTER_API_KEY=
ROBOWEAVER_OPENROUTER_MODEL=openrouter/free
# Optional feature overrides:
ROBOWEAVER_OPENROUTER_MODEL_CODEGEN=cohere/north-mini-code:free
# ROBOWEAVER_OPENROUTER_MODEL_ADVISOR=openrouter/free
#
# Google models are reached through OpenRouter; there is no separate direct-Gemini
# client. google/gemini-2.5-flash-lite is NOT one of OpenRouter's `:free`-suffixed
# models (verified against the live /api/v1/models list) -- it is inexpensive but
# does spend your OpenRouter balance.
#
# Measured on the Research Lab embodiment task (large strict-schema JSON):
#   google/gemini-2.5-flash-lite  ~20-37s, returns the model you asked for  (paid)
#   free `:free` models           ~64-98s, and OpenRouter silently served a
#                                 *different* model than requested via fallback
# The cascade allows 30s per attempt / 55s total, so the free tiers time out on
# this endpoint. They remain fine for short prose features like ADVISOR/CODEGEN.
ROBOWEAVER_OPENROUTER_MODEL_EXPERIMENT=google/gemini-2.5-flash-lite
ROBOWEAVER_OPENROUTER_MODEL_MLIR_EXPLAIN=google/gemini-2.5-flash-lite
