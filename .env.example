# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ROBOWEAVER_API_TOKEN=replace-with-a-random-token

# Comma-separated exact browser origins allowed to call the API.
ROBOWEAVER_ALLOWED_ORIGINS=http://localhost:3000

# Fully local AI / Ollama. Every feature is opt-in and falls back honestly.
OLLAMA_HOST=http://localhost:11434
ROBOWEAVER_MODEL_DEFAULT=llama3.1:8b
# Optional per-feature overrides:
# ROBOWEAVER_MODEL_PARSER=llama3.2:3b
# ROBOWEAVER_MODEL_EXPLAINER=llama3.1:8b
# ROBOWEAVER_MODEL_RECOVERY=llama3.1:8b
# ROBOWEAVER_MODEL_COMPOSER=llama3.1:8b
# ROBOWEAVER_MODEL_ENRICHMENT=llama3.1:8b
# ROBOWEAVER_MODEL_CODEGEN=codellama:7b
# ROBOWEAVER_MODEL_ADVISOR=llama3.2:3b
# ROBOWEAVER_MODEL_CHAT=llama3.1:8b
